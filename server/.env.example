# ==========================================
# Server & Environment Configuration
# ==========================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
MONGO_URI=mongodb://localhost:27017/social_app

# ==========================================
# JWT Authentication Secrets
# ==========================================
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_RESET_SECRET=your_jwt_reset_password_secret_key_here

# ==========================================
# JWT Expiration Times
# ==========================================
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# ==========================================
# SMTP Email Configuration (Nodemailer / OTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
MAIL_FROM="SocialApp <noreply@socialapp.com>"