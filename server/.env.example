# ==========================================
# Server & Environment Configuration
# ==========================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
MONGO_URI=mongodb://localhost:27017/social_app

# ==========================================
# JWT Authentication Secrets
# ==========================================
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_RESET_SECRET=your_jwt_reset_password_secret_key_here

# ==========================================
# JWT Expiration Times
# ==========================================
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# ==========================================
# OAuth Configuration (Google & Facebook)
# ==========================================
SERVER_URL=http://localhost:3000
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...


# ==========================================
# SMTP Email Configuration (Nodemailer / OTP)
# ==========================================
RESEND_API_KEY=re_123456789_your_actual_api_key
MAIL_FROM=onboarding@resend.dev